// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Game {
  id            Int          @id @default(autoincrement())
  name          String       @default("Example Name")
  subgames      Game[]      @relation("subgame")
  parentgameid  Int?
  parentgame    Game?       @relation("subgame", fields: [parentgameid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  superparentgameid Int?
  superparentgame Game?     @relation("supergamesubgames", fields: [superparentgameid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentgamesubgamesindex Int?
  isbasecase    Int         @default(0)
  basecasedrillsetup  String?   @db.VarChar(1000)
  basecasedrillexecution  String?   @db.VarChar(1000)
  basecaselastcompleted     DateTime?
  basecasenextcompletiondate  DateTime?
  basecaserepetitions       Int       @default(0)
  basecasedrillactivated  Int   @default(0)
  creationdate   DateTime   @default(now())
  finitegame     Int        @default(0)
  userid         Int        
  user           User       @relation(fields: [userid], references: [id], onDelete: Cascade)
  @@index([parentgameid])
  @@index([userid])
  @@index([superparentgameid])
  supergamesubgames Game[]  @relation("supergamesubgames")
}

model User {
  id            Int           @id @default(autoincrement())
  email         String      @unique
  name          String
  joindate      DateTime      @default(now())
  games         Game[]
  todaynewfinitegamebehaviorcount   Int     @default(0)
  lastfinitegamebehaviorcountreset  DateTime?
  premiumsubscriber Int   @default(0)
  premiumsubscriberexpirationdate DateTime?
  stripecustomerid    String?     @unique
}